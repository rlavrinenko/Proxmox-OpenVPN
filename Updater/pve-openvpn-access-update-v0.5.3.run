__PVE_OVPN_FIX_PAYLOAD__

tar -xzf "$PAYLOAD" -C "$TMP"

STAMP="$(date +%Y%m%d-%H%M%S)"
BACKUP="/root/pve-openvpn-access-pre-${VERSION}-${STAMP}"
mkdir -p "$BACKUP"

for f in   /usr/share/perl5/PVE/API2/OpenVPNAccess.pm   /usr/share/pve-manager/js/pve-openvpn-access.js   /usr/local/sbin/pve-openvpn-repatch   /usr/local/sbin/pve-openvpn-diagnose   /usr/local/sbin/pve-ovpnctl   /usr/share/pve-manager/index.html.tpl   /usr/share/perl5/PVE/API2/Nodes.pm
do
  [[ -e "$f" ]] && cp -a "$f" "$BACKUP/$(basename "$f")"
done

echo "Backup: $BACKUP"

install -m 0644 "$TMP/OpenVPNAccess.pm" /usr/share/perl5/PVE/API2/OpenVPNAccess.pm
install -m 0644 "$TMP/pve-openvpn-access.js" /usr/share/pve-manager/js/pve-openvpn-access.js
install -m 0755 "$TMP/pve-openvpn-repatch" /usr/local/sbin/pve-openvpn-repatch
install -m 0755 "$TMP/pve-openvpn-diagnose" /usr/local/sbin/pve-openvpn-diagnose
install -m 0755 "$TMP/pve-ovpnctl" /usr/local/sbin/pve-ovpnctl

echo "[1/4] Verifying API module..."
perl -I/usr/share/perl5 -MPVE::API2::OpenVPNAccess -e 'print "OpenVPNAccess API module OK\n"'

echo "[2/4] Refreshing native :8006 hook..."
/usr/local/sbin/pve-openvpn-repatch

echo "[3/4] Restarting Proxmox API services..."
systemctl restart pvedaemon
systemctl restart pveproxy
sleep 2

echo "[4/4] Checking services and fix..."
systemctl is-active --quiet pvedaemon || {
  echo "ERROR: pvedaemon is not active" >&2
  exit 3
}
systemctl is-active --quiet pveproxy || {
  echo "ERROR: pveproxy is not active" >&2
  exit 3
}

if grep -Eq "path => '(server-delete|user-delete|acl-delete|site-delete)', method => 'DELETE'"   /usr/share/perl5/PVE/API2/OpenVPNAccess.pm; then
  echo "ERROR: DELETE API registrations still found" >&2
  exit 4
fi

if grep -Eq "api\('/(server-delete|user-delete|acl-delete|site-delete)','DELETE'"   /usr/share/pve-manager/js/pve-openvpn-access.js; then
  echo "ERROR: DELETE calls still found in UI" >&2
  exit 4
fi

echo
echo "PVE OpenVPN Access $VERSION update installed successfully."
echo "Configuration and PKI were not changed."
echo
echo "Press Ctrl+F5 in the browser."
echo "Then test LAN Access -> select rule -> Remove."

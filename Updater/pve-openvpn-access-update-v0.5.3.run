#!/bin/bash
set -Eeuo pipefail
VERSION="0.5.3"

if [[ $EUID -ne 0 ]]; then
  echo "ERROR: run as root" >&2
  exit 1
fi

command -v pveversion >/dev/null 2>&1 || {
  echo "ERROR: Proxmox VE not detected" >&2
  exit 1
}

cat <<'EOF'
============================================================
PVE OpenVPN Access 0.5.3 update

Fix:
  501 Unexpected content for method 'DELETE'

Affected actions fixed:
  - LAN Access -> Remove
  - Users / Peers -> Remove
  - Servers -> Remove
  - MikroTik / Routes -> Remove

IMPORTANT:
Run through external SSH / physical console / IPMI/iDRAC/iLO.
DO NOT use Proxmox Web UI -> Node -> Shell.

This update restarts pvedaemon and pveproxy.
============================================================
EOF

for required in   /usr/share/perl5/PVE/API2/OpenVPNAccess.pm   /usr/share/pve-manager/js/pve-openvpn-access.js
do
  if [[ ! -f "$required" ]]; then
    echo "ERROR: existing PVE OpenVPN Access installation not found: $required" >&2
    exit 2
  fi
done

TMP="$(mktemp -d /tmp/pve-openvpn-access-update.XXXXXX)"
trap 'rm -rf "$TMP"' EXIT
PAYLOAD="$TMP/payload.tar.gz"

base64 -d >"$PAYLOAD" <<'__PVE_OVPN_FIX_PAYLOAD__'
